# ==============================================================================
# FieldShift 2026 — Safe Environment Template (Root)
# Copy this file to .env and configure your production values.
# NEVER commit real credentials, service-role keys, or database passwords to git.
# ==============================================================================

# Database Connection (Supabase PostgreSQL or local fallback)
# Use session pooler (port 5432) or direct URL for migrations:
# DATABASE_URL="postgresql://postgres.[project-ref]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:5432/postgres"
# Or transaction pooler (port 6543) for high-concurrency:
# DATABASE_URL="postgresql://postgres.[project-ref]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
DATABASE_URL=postgresql://postgres.your_project_ref:your_password@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres

# Optional secondary/legacy database URL variable
# FIELDSHIFT_DATABASE_URL=

# Database pool tuning
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Gemini API Key (Backend AI Agronomist)
GEMINI_API_KEY=your_gemini_api_key_here

# Allowed CORS Origins (comma-separated, for production frontend deployment)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-frontend.vercel.app

# Server Port
PORT=8000
