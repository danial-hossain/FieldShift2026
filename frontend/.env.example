# ==============================================================================
# FieldShift Frontend Configuration
# Copy this file to frontend/.env and configure your production values.
# NEVER place backend service-role keys or PostgreSQL credentials here!
# ==============================================================================

# Backend API Base URL (leave empty in local dev to use Vite proxy, or set to production backend URL)
VITE_API_URL=http://127.0.0.1:8000

# Client-side Gemini API Key (optional fallback)
VITE_GEMINI_API_KEY=your_gemini_api_key_here
